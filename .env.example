# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SOCKET_PORT=3002

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_IP=mongodb://localhost:27017
MONGO_IP_LOCAL=mongodb://localhost:27017
MONGO_DB=realistanDB
# Mongoose URI (used by serveease module)
MONGODB_URI=mongodb://localhost:27017/realistanDB

# ─── Redis ───────────────────────────────────────────────────────────────────
CHECK_REDIS=false
REDIS_URL=redis://localhost:6379
REDIS_SERVER=localhost
REDIS_PORT=6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SIG=change_this_secret
JWT_SECRET=change_this_secret
JWT_ACCESS_TOKEN_SECRET=change_this_secret
JWT_ACCESS_TOKEN_SECRET_EXPIRY=7d
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Unified admin JWT — defaults to JWT_SIG if not set. Set to same value in single-secret setups.
JWT_ADMIN_SECRET=change_this_admin_secret

# ─── Elasticsearch ───────────────────────────────────────────────────────────
ELASTIC_SEARCH_IP=http://localhost:9200

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=3
OTP_DEV_MODE=true
OTP_SEND_ENABLED=true
OTP_SEND_MAX_RETRIES=2
# Super admin fixed OTP — used in non-production only. Leave empty in production to require real SMS.
SUPER_ADMIN_OTP=964321
# Default password for super admins seeded by seed:superusers script
SUPER_ADMIN_DEFAULT_PASSWORD=Admin@Realistan2025

# ─── SMS (Kaleyra) ───────────────────────────────────────────────────────────
SMS_PRIMARY_PROVIDER=kaleyra
SMS_FALLBACK_PROVIDER=smsstriker
SMS_3RDP_KEY=
SMS_3RDP_ACCID=
SMS_3RDP_SENDER=
SMS_3RDP_TEMPLATE=
KALEYRA_SENDER_URL=https://cloud-api.in.kaleyra.io/v1/HXXX/messages
KALEYRA_KEY=
KALEYRA_SENDER_ID=REALST
KALEYRA_TEMPLATE={#numeric#} is your OTP for Realistan. Valid for 10 minutes.

# ─── SMS (SMSStriker fallback) ────────────────────────────────────────────────
SMSSTRIKER_URL=https://smsstriker.com/API/sms.php
SMSSTRIKER_USERNAME=
SMSSTRIKER_PASSWORD=

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
WHATS_OTP_SEND=false
WHATSAPP_PRIMARY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_NUMBER=+14155238886
TWILIO_CONTENT_SID=
TWILIO_URL=

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=realistan-assets
CSVBUCKET=

# ─── Social Auth ─────────────────────────────────────────────────────────────
IOS_CLIENT_ID=
ANDROID_CLIENT_ID=
WEB_CLIENT_ID=
IOS_AUD=
FB_GRAPH_API=https://graph.facebook.com/me
TRUECALLER_CLIENT_ID=
URI_TRUECALLER_TOKEN=
URI_USER_INFO=

# ─── Razorpay (ServeEase payments) ───────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Web Push Notifications ──────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@realistan.in

# ─── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=./config/firebase-service-account.json

# ─── Anthropic (AI Recommendations) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Misc ────────────────────────────────────────────────────────────────────
IMAGE_ENDPOINT=
